# Python
__pycache__/
*.pyc
.venv*/
venv/

# Editor-specific settings (not needed to run the project)
.vscode/

# Trained weights/checkpoints (too large for git; shared separately, see
# weights_hub.py / ui.py for automatic download from Hugging Face Hub)
*.pth
*.pt
*.safetensors

# Model cache downloaded by render/generate.py
.cache/

# Pipeline run outputs (regenerated by pipeline.py on every run; the
# figures actually cited in the report are checked into report/ instead)
OsteoGen_V.2/outputs/

# Diagnostic heatmap snapshots from check_heatmap.py (regenerated on demand)
OsteoGen_V.2/data/processed/Heatmap_Checks/

# LaTeX build byproducts (report/main.pdf stays tracked; these regenerate
# on compile)
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.synctex.gz
